# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored, so your password never gets committed.

# Port: 5432 = PostgreSQL 16, 5433 = 17, 5435 = 18 on this machine
DB_URL=jdbc:postgresql://localhost:5432/mywatchmate
DB_USERNAME=mywatchmate
DB_PASSWORD=

# Signs login tokens. Required, at least 32 characters, random, never shared.
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# Optional: frontend origins allowed to call the API (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: where invite links point (<FRONTEND_URL>/join/<token>), and room size limit
# FRONTEND_URL=http://localhost:3000
# MAX_MEMBERS_PER_SPACE=50

# Optional: HTTP port for the app (defaults to 8081)
# SERVER_PORT=8081

# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored, so your password never gets committed.

# Port: 5432 = PostgreSQL 16, 5433 = 17, 5435 = 18 on this machine
DB_URL=jdbc:postgresql://localhost:5432/mywatchmate
DB_USERNAME=mywatchmate
DB_PASSWORD=

# Optional: HTTP port for the app (defaults to 8081)
# SERVER_PORT=8081
